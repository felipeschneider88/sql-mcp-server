PORT=3000

# Multi-instance (recommended)
# auth: "aad" (device code MFA) | "sql" (user/password)
INSTANCES=[{"name":"prod","host":"prod.database.windows.net","auth":"aad"},{"name":"dev","host":"dev-sql","auth":"sql","user":"dba_monitor","password":"secret"}]

# Single-instance fallback (if INSTANCES not set)
# SQL_SERVER=sqlserver
# SQL_PORT=1433
# SQL_AUTH=aad
# SQL_USER=dba_monitor
# SQL_PASSWORD=
